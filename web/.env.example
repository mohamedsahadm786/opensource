# Copy this file to `.env.local` and fill in your Supabase project.
# Vite only exposes vars prefixed with VITE_ to the browser.
#
# IMPORTANT: use the ANON / PUBLISHABLE key here — NEVER the service/secret key.
# The browser is RLS-scoped by tenant_id from the JWT; the service key lives only
# inside the Supabase Edge Functions (server-side).

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
